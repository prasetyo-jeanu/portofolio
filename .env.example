# Application
SITE_URL=http://localhost:4321
NODE_ENV=development
HOST=0.0.0.0
PORT=4321

# Database (MySQL on Easypanel or local)
DATABASE_URL=mysql://root:password@localhost:3306/portfolio
# Storage Paths (In Docker/Easypanel, mount persistent volume at /data)
DATABASE_PATH=./data/portfolio.db
UPLOAD_DIR=./data/uploads
# Local dev: ./dist-public | Docker/Easypanel production: /data/dist-public
PUBLIC_DIST_DIR=./dist-public

# Authentication & Security
SESSION_SECRET=change-this-to-a-long-random-hex-secret-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_NAME=Developer Admin

# Publishing
PUBLISH_LOCK_TIMEOUT_MS=300000
