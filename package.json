{
  "name": "developer-portfolio-cms",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun astro dev",
    "build:content": "bun run scripts/materialize-content.ts",
    "build": "bun run build:content && bun --bun astro build && bunx pagefind --site dist/client",
    "preview": "bun run server/entrypoint.ts",
    "start": "bun run server/entrypoint.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "portfolio:import": "bun run scripts/import-portfolio.ts",
    "freelance:import": "bun run scripts/import-freelance.ts",
    "freelance:import-en": "bun run scripts/import-freelance.ts --en",
    "db:studio": "bun --bun drizzle-kit studio",
    "check": "bun --bun astro check",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "export:data": "bun run scripts/export-transfer.ts",
    "deploy:webhook": "curl.exe -X POST http://217.217.255.58:3000/api/deploy/554a2f63340cb1563307fad1a0d79520c846cf0d9cd4b110"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/node": "^11.1.13",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.36.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.4",
    "marked": "^15.0.12",
    "pagefind": "^1.6.0",
    "sanitize-html": "^2.17.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/bun": "^1.4.4",
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.3"
  }
}
