---
import { getTranslations } from '../lib/i18n';
import type { Locale } from '../db/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<button
  type="button"
  data-theme-toggle
  aria-label={t.themeToggle}
  title={t.themeToggle}
  class="group inline-flex min-h-[44px] sm:min-h-0 items-center cursor-pointer"
>
  <span class="inline-flex h-7 items-center gap-0.5 rounded-full border border-[var(--border-subtle)] bg-[#393E46]/15 dark:border-[#EEEEEE]/25 dark:bg-[#393E46]/70 p-0.5 text-[var(--text-primary)] transition-colors group-hover:border-[var(--accent)]">
    <span
      aria-hidden="true"
      class="inline-flex h-5.5 w-5.5 items-center justify-center rounded-full bg-[#222831] text-[#EEEEEE] dark:bg-transparent dark:text-[#cfd4dc] transition-colors"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
    </span>
    <span
      aria-hidden="true"
      class="inline-flex h-5.5 w-5.5 items-center justify-center rounded-full bg-transparent text-[#222831]/65 dark:bg-[#222831] dark:text-[#FFD369] dark:ring-1 dark:ring-[#FFD369]/40 transition-colors"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </span>
  </span>
</button>

<script>
  function bindThemeToggles() {
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      if ((btn as HTMLElement).dataset.bound === 'true') return;
      (btn as HTMLElement).dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch {}
      });
    });
  }
  bindThemeToggles();
  document.addEventListener('astro:after-swap', bindThemeToggles);
</script>
