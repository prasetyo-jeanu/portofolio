  function initContactCopyButtons() {
    const copyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-copy-email]'));
    if (copyButtons.length === 0) return;

    const statusEl = document.getElementById('contact-copy-status');
    const resetTimers = new WeakMap<HTMLButtonElement, number>();

    const writeToClipboard = async (text: string): Promise<boolean> => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Fallback below for non-secure origins or restricted clipboard permissions
        }
      }
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      let copied = false;
      try {
        copied = document.execCommand('copy');
      } catch {
        copied = false;
      }
      document.body.removeChild(textarea);
      return copied;
    };

    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-copy-email') || '';
        if (!email) return;

        const copied = await writeToClipboard(email);
        if (!copied) return;

        const defaultText = btn.getAttribute('data-copy-default') || 'Copy';
        const doneText = btn.getAttribute('data-copy-done') || 'Copied';
        const announceText = btn.getAttribute('data-copy-announce') || doneText;
        const labelEl = btn.querySelector<HTMLElement>('[data-copy-label]');
        const copyIcon = btn.querySelector<SVGElement>('.contact-copy-icon');
        const checkIcon = btn.querySelector<SVGElement>('.contact-check-icon');

        if (labelEl) labelEl.textContent = doneText;
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        btn.classList.add('border-[var(--accent)]', 'text-[var(--accent)]');
        if (statusEl) statusEl.textContent = announceText;

        const prevTimer = resetTimers.get(btn);
        if (prevTimer) window.clearTimeout(prevTimer);

        const nextTimer = window.setTimeout(() => {
          if (labelEl) labelEl.textContent = defaultText;
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          btn.classList.remove('border-[var(--accent)]', 'text-[var(--accent)]');
        }, 1800);
        resetTimers.set(btn, nextTimer);
      });
    });
  }

  initContactCopyButtons();
</script>

