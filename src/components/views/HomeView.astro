    const pickRandomSnippet = (exclude?: CodeSnippet): CodeSnippet => {
      const diffLang = exclude ? snippets.filter((s) => s.lang !== exclude.lang) : snippets;
      const pool = diffLang.length > 0 ? diffLang : snippets;
      return pool[Math.floor(Math.random() * pool.length)]!;
    };

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = pickRandomSnippet();
    let fullText = current.lines.join('\n');
    let cursor = 0;
    let timerId = 0;
    let pausedForHidden = false;

    const renderMeta = (snippet: CodeSnippet) => {
      langEl.textContent = snippet.lang;
      fileEl.textContent = snippet.file;
    };

    renderMeta(current);

    if (reducedMotion) {
      codeEl.textContent = fullText;
      return;
    }

    const scheduleTick = () => {
      window.clearTimeout(timerId);
      if (pausedForHidden) return;

      if (cursor < fullText.length) {
        const chunkSize = 2 + Math.floor(Math.random() * 2);
        cursor = Math.min(fullText.length, cursor + chunkSize);
        codeEl.textContent = fullText.slice(0, cursor);
        const lastChar = fullText[cursor - 1];
        const delay = lastChar === '\n' ? 50 : 16 + Math.floor(Math.random() * 18);
        timerId = window.setTimeout(scheduleTick, delay);
        return;
      }

      timerId = window.setTimeout(() => {
        bgEl.classList.add('is-switching');
        timerId = window.setTimeout(() => {
          current = pickRandomSnippet(current);
          fullText = current.lines.join('\n');
          cursor = 0;
          renderMeta(current);
          codeEl.textContent = '';
          bgEl.classList.remove('is-switching');
          scheduleTick();
        }, 300);
      }, 2100);
    };

    document.addEventListener('visibilitychange', () => {
      pausedForHidden = document.hidden;
      if (pausedForHidden) {
        window.clearTimeout(timerId);
      } else {
        scheduleTick();
      }
    });

    scheduleTick();
  }

