<script>
  interface HeroSlide {
    plain: string;
    segments: Array<{ text: string; accent: boolean }>;
  }

  function initHeroRotator() {
    const heroSection = document.getElementById('hero');
    const heading = document.getElementById('hero-rotating-heading');
    const textHost = heading?.querySelector('[data-hero-text]');
    const indexEl = document.querySelector('[data-hero-index]');
    const progressEl = document.querySelector('[data-hero-progress]') as HTMLElement | null;
    const stepButtons = Array.from(document.querySelectorAll('[data-hero-dot]'));
    if (!heroSection || !heading || !textHost) return;

    let slides: HeroSlide[] = [];
    try {
      slides = JSON.parse(heading.getAttribute('data-hero-slides') || '[]') as HeroSlide[];
    } catch {
      slides = [];
    }
    if (slides.length <= 1) return;

    const DWELL_MS = 3400;
    const HOVER_DWELL_MS = 10000;
    const DECODE_MS = 520;
    const GLYPHS = '01<>/#_=+*[]';
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let currentIdx = 0;
    let rafId = 0;
    let timerId = 0;
    let slowed = false;
    let isDwelling = false;
    let dwellStartedAt = 0;
    let dwellTotalMs = DWELL_MS;
    let dwellBaseFraction = 0;

    const pad2 = (n: number) => String(n).padStart(2, '0');
    const totalLabel = pad2(slides.length);

    function renderCleanSlide(slide: HeroSlide) {
      const frag = document.createDocumentFragment();
      for (const seg of slide.segments) {
        const span = document.createElement('span');
        if (seg.accent) span.className = 'text-[var(--accent)]';
        span.textContent = seg.text;
        frag.appendChild(span);
      }
      textHost!.replaceChildren(frag);
      heading!.setAttribute('aria-label', slide.plain);
    }

    function updateTelemetry(idx: number) {
      if (indexEl) {
        indexEl.textContent = `${pad2(idx + 1)} / ${totalLabel}`;
      }
      stepButtons.forEach((btn, i) => {
        btn.setAttribute('aria-pressed', i === idx ? 'true' : 'false');
      });
    }

    function restartProgress(totalMs: number, elapsedFraction = 0) {
      if (!progressEl || prefersReducedMotion) return;
      progressEl.classList.remove('is-running');
      progressEl.style.animationDuration = `${totalMs}ms`;
      progressEl.style.animationDelay = `-${Math.round(elapsedFraction * totalMs)}ms`;
      progressEl.style.animationPlayState = 'running';
      void progressEl.offsetWidth;
      progressEl.classList.add('is-running');
    }

    function getActiveDwellMs() {
      if (slowed) return HOVER_DWELL_MS;
      return prefersReducedMotion ? 4500 : DWELL_MS;
    }

    function scheduleNext(elapsedFraction = 0) {
      window.clearTimeout(timerId);
      if (document.hidden) {
        isDwelling = false;
        return;
      }
      const clampedFraction = Math.min(0.99, Math.max(0, elapsedFraction));
      const totalMs = getActiveDwellMs();
      const remainingMs = Math.max(80, Math.round((1 - clampedFraction) * totalMs));
      isDwelling = true;
      dwellStartedAt = performance.now();
      dwellTotalMs = totalMs;
      dwellBaseFraction = clampedFraction;
      restartProgress(totalMs, clampedFraction);
      timerId = window.setTimeout(() => {
        isDwelling = false;
        transitionTo((currentIdx + 1) % slides.length);
      }, remainingMs);
    }

    function transitionTo(nextIdx: number) {
      if (nextIdx === currentIdx) return;
      window.cancelAnimationFrame(rafId);
      window.clearTimeout(timerId);
      isDwelling = false;

      const fromPlain = slides[currentIdx]?.plain || '';
      const target = slides[nextIdx];
      currentIdx = nextIdx;
      updateTelemetry(nextIdx);

      if (prefersReducedMotion) {
        renderCleanSlide(target);
        scheduleNext();
        return;
      }

      const targetChars: Array<{ ch: string; accent: boolean }> = [];
      for (const seg of target.segments) {
        for (const ch of seg.text) {
          targetChars.push({ ch, accent: seg.accent });
        }
      }

      const startTime = performance.now();
      const fromLen = fromPlain.length;
      const targetLen = targetChars.length;

      const stepFrame = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(1, elapsed / DECODE_MS);
        if (progress >= 1) {
          renderCleanSlide(target);
          scheduleNext();
          return;
        }

        const stepBucket = Math.floor(elapsed / 42);
        const displayLen = Math.max(
          1,
          Math.round(fromLen + (targetLen - fromLen) * Math.min(1, progress * 1.45)),
        );

        const frag = document.createDocumentFragment();
        let runKind: 'normal' | 'accent' | 'cipher' | null = null;
        let runText = '';

        const flushRun = () => {
          if (!runText || !runKind) return;
          const span = document.createElement('span');
          if (runKind === 'accent') span.className = 'text-[var(--accent)]';
          else if (runKind === 'cipher') span.className = 'text-[var(--accent)]/65';
          span.textContent = runText;
          frag.appendChild(span);
          runText = '';
        };

        for (let i = 0; i < displayLen; i++) {
          const item = targetChars[i];
          const resolveThreshold = 0.14 + (i / Math.max(1, targetLen)) * 0.72;
          let ch = ' ';
          let kind: 'normal' | 'accent' | 'cipher' = 'cipher';

          if (item && item.ch === ' ') {
            ch = ' ';
            kind = item.accent ? 'accent' : 'normal';
          } else if (item && progress >= resolveThreshold) {
            ch = item.ch;
            kind = item.accent ? 'accent' : 'normal';
          } else {
            ch = GLYPHS[(i * 7 + stepBucket * 13) % GLYPHS.length];
            kind = 'cipher';
          }

          if (kind !== runKind) {
            flushRun();
            runKind = kind;
          }
          runText += ch;
        }
        flushRun();

        textHost!.replaceChildren(frag);
        rafId = window.requestAnimationFrame(stepFrame);
      };

      rafId = window.requestAnimationFrame(stepFrame);
    }

    stepButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-hero-dot'));
        if (!Number.isNaN(idx) && idx >= 0 && idx < slides.length) {
          transitionTo(idx);
        }
      });
    });

    const setSlowed = (nextSlowed: boolean) => {
      if (slowed === nextSlowed) return;
      let currentFraction = 0;
      if (isDwelling) {
        currentFraction = Math.min(
          0.99,
          dwellBaseFraction + (performance.now() - dwellStartedAt) / Math.max(1, dwellTotalMs),
        );
      }
      slowed = nextSlowed;
      if (isDwelling) {
        scheduleNext(currentFraction);
      }
    };

    heroSection.addEventListener('pointerenter', () => setSlowed(true));
    heroSection.addEventListener('pointerleave', () => setSlowed(false));
    heroSection.addEventListener('focusin', () => setSlowed(true));
    heroSection.addEventListener('focusout', () => {
      if (!heroSection.contains(document.activeElement)) setSlowed(false);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        window.clearTimeout(timerId);
        isDwelling = false;
      } else {
        scheduleNext();
      }
    });

    scheduleNext();
  }

  initHeroRotator();

  type CodeSnippet = {
    lang: 'PYTHON' | 'TYPESCRIPT' | 'PHP' | 'GOLANG';
    file: string;
    lines: string[];
  };

  function initHeroCodeBackground() {
    const bgEl = document.querySelector<HTMLElement>('[data-hero-code-bg]');
    const langEl = document.querySelector<HTMLElement>('[data-hero-code-lang]');
    const fileEl = document.querySelector<HTMLElement>('[data-hero-code-file]');
    const codeEl = document.querySelector<HTMLElement>('[data-hero-code-text]');
    if (!bgEl || !langEl || !fileEl || !codeEl) return;

    const snippets: CodeSnippet[] = [
