  function openProjectModal(slug: string, updateHash = true) {
    const dialog = projectModals.find((el) => el.getAttribute('data-project-modal') === slug);
    if (!dialog) return;

    const currentlyOpen = projectModals.find((el) => el.open && el !== dialog);
    if (currentlyOpen) {
      suppressHashCleanup = true;
      currentlyOpen.close();
      suppressHashCleanup = false;
    }

    dialog.scrollTop = 0;
    if (!dialog.open) {
      dialog.showModal();
    }
    if (updateHash && window.location.hash !== `#project-${slug}`) {
      window.history.replaceState(null, '', `#project-${slug}`);
    }
  }

