---
import { render } from 'astro:content';
import type { Locale } from '../../db/schema';
import { getPublishedPostsByLocale, getPublishedProjectsByLocale } from '../../lib/content-queries';
import { getPublishedFreelanceProjectsByLocale } from '../../lib/freelance-queries';
import { getLocalizedSectionPath, getProjectUrl, getTranslations } from '../../lib/i18n';
import { buildAbsoluteUrl, buildPersonJsonLd, buildWebsiteJsonLd } from '../../lib/seo';
import { getSiteSettings, parseHeadlineSegments, sanitizeImageUrl, stripHeadlineMarkers } from '../../lib/settings';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProjectCard from '../ProjectCard.astro';
import PostCard from '../PostCard.astro';
import CopyCodeEnhancer from '../CopyCodeEnhancer.astro';
import Callout from '../mdx/Callout.astro';
import Figure from '../mdx/Figure.astro';

export interface Props {
  locale: Locale;
  canonicalPath?: string;
}

const { locale } = Astro.props;
const canonicalPath = Astro.props.canonicalPath ?? (locale === 'en' ? '/' : '/id/');
const t = getTranslations(locale);
const settings = await getSiteSettings();

const allPosts = await getPublishedPostsByLocale(locale);
const latestPosts = allPosts.slice(0, 3);
const allProjects = await getPublishedProjectsByLocale(locale);
const freelanceItems = await getPublishedFreelanceProjectsByLocale(locale);
const hasFreelance = freelanceItems.length > 0;

const renderedProjects = await Promise.all(
  allProjects.map(async (project) => {
    const { Content } = await render(project);
    return { project, Content };
  }),
);

const tagCounts = new Map<string, number>();
for (const project of allProjects) {
  for (const tag of project.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}
const allProjectTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag)
  .slice(0, 8);
const displayProjectTags =
  allProjectTags.length > 0 ? allProjectTags : settings.coreStack.slice(0, 5);

const freelanceTagCounts = new Map<string, number>();
for (const item of freelanceItems) {
  for (const tag of item.techStack) {
    freelanceTagCounts.set(tag, (freelanceTagCounts.get(tag) || 0) + 1);
  }
}
const displayFreelanceTags = Array.from(freelanceTagCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag)
  .slice(0, 8);

const aboutSectionId = locale === 'id' ? 'tentang' : 'about';
const projectsSectionId = locale === 'id' ? 'proyek' : 'projects';
const contactSectionId = locale === 'id' ? 'kontak' : 'contact';

const projectsHref = getLocalizedSectionPath(locale, 'projects');
const contactHref = getLocalizedSectionPath(locale, 'contact');
const blogHref = getLocalizedSectionPath(locale, 'blog');
const alternatePath = locale === 'id' ? '/' : '/id/';

const heroHeadline = locale === 'id' ? settings.headlineId : settings.headlineEn;
const heroIntro = locale === 'id' ? settings.introId : settings.introEn;
const backgroundBody = locale === 'id' ? settings.aboutBackgroundId : settings.aboutBackgroundEn;
const philosophyBody = locale === 'id' ? settings.aboutPhilosophyId : settings.aboutPhilosophyEn;
const coreStack = settings.coreStack;
const expertiseItems = locale === 'id' ? settings.expertiseId : settings.expertiseEn;
const experienceItems = locale === 'id' ? settings.experienceId : settings.experienceEn;

const heroPhrase = locale === 'id' ? 'aplikasi web bisnis' : 'business web applications';
const rawHeroHeadlines = locale === 'id' ? settings.heroHeadlinesId : settings.heroHeadlinesEn;
const parsedHeroSlides = (rawHeroHeadlines.length > 0 ? rawHeroHeadlines : [heroHeadline]).map((line) => ({
  plain: stripHeadlineMarkers(line),
  segments: parseHeadlineSegments(line, heroPhrase),
}));
const heroLeadSlide = parsedHeroSlides[0];
const rotatingHeroSlides = parsedHeroSlides.slice(1);
const initialRotatingSlide = rotatingHeroSlides[0] ?? null;
const slideControlsLabel = locale === 'id' ? 'Pilih pesan hero' : 'Select hero message';
const slideLabelPrefix = locale === 'id' ? 'Slide hero' : 'Hero slide';

const hreflangs = [
  { locale: 'id' as const, url: buildAbsoluteUrl('/id/') },
  { locale: 'en' as const, url: buildAbsoluteUrl('/') },
  { locale: 'x-default' as const, url: buildAbsoluteUrl('/') },
];

const authorDisplayName =
  settings.developerName && settings.developerName !== 'Fullstack Engineer'
    ? settings.developerName
    : settings.siteName;
const seoTitle =
  settings.developerName && settings.developerName !== 'Fullstack Engineer'
    ? `${settings.developerName} — ${settings.siteName}`
    : `${settings.siteName} — Senior Fullstack Developer`;
const stackSummary = coreStack.slice(0, 5).join(', ');
const seoDescription =
  heroHeadline.length >= 115 || !stackSummary
    ? heroHeadline
    : `${heroHeadline.replace(/\.$/, '')}. Core stack: ${stackSummary}.`;

const jsonLd = [
  buildPersonJsonLd({
    name: authorDisplayName,
    jobTitle: t.hero.badge,
    description: seoDescription,
    url: buildAbsoluteUrl(canonicalPath),
    image: '/og-default.png',
    sameAs: [settings.githubUrl, settings.gitlabUrl, settings.linkedinUrl],
    knowsAbout: coreStack,
  }),
  buildWebsiteJsonLd({
    name: settings.siteName,
    url: buildAbsoluteUrl(canonicalPath),
    locale,
    description: seoDescription,
  }),
];

const pillClass =
  'project-filter-pill inline-flex min-h-[44px] sm:min-h-[34px] cursor-pointer items-center rounded border px-3 py-1 font-mono text-[12.5px] leading-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]';

const filterGroupLabel = locale === 'id' ? 'Filter proyek berdasarkan teknologi' : 'Filter projects by stack';
const viewGroupLabel = locale === 'id' ? 'Pilihan tampilan proyek' : 'Project layout view';
const gridViewLabel = locale === 'id' ? 'Tampilan grid' : 'Grid view';
const listViewLabel = locale === 'id' ? 'Tampilan list penuh' : 'Full-width list view';
const closeModalLabel = locale === 'id' ? 'Tutup dialog studi kasus' : 'Close case study dialog';
const modalCloseText = locale === 'id' ? 'Tutup' : 'Close';
const modalCloseBtnClass =
  'inline-flex min-h-[38px] shrink-0 cursor-pointer items-center gap-1.5 rounded border border-[var(--text-muted)]/45 bg-[var(--bg-elevated)] px-3 py-1.5 font-mono text-xs font-semibold uppercase tracking-[0.08em] text-[var(--text-primary)] shadow-sm transition-colors hover:border-[var(--accent)] hover:bg-[var(--accent-fill)] hover:text-[var(--accent-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]';

type ChannelKind = 'github' | 'gitlab' | 'linkedin' | 'x';
interface DirectChannel {
  kind: ChannelKind;
  label: string;
  href: string;
  displayValue: string;
}

function sanitizeChannelUrl(raw: string): string {
  const clean = raw.trim();
  if (!clean) return '';
  try {
    const parsed = new URL(clean);
    return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.toString() : '';
  } catch {
    return '';
  }
}

function formatChannelDisplay(url: string): string {
  return url.replace(/^https?:\/\/(?:www\.)?/i, '').replace(/\/+$/, '');
}

const rawChannelEntries: Array<{ kind: ChannelKind; label: string; url: string }> = [
  { kind: 'github', label: 'GITHUB', url: settings.githubUrl },
  { kind: 'gitlab', label: 'GITLAB', url: settings.gitlabUrl },
  { kind: 'linkedin', label: 'LINKEDIN', url: settings.linkedinUrl },
  { kind: 'x', label: 'X / TWITTER', url: settings.xUrl },
];

const directChannels: DirectChannel[] = rawChannelEntries
  .map((entry) => {
    const href = sanitizeChannelUrl(entry.url);
    return href ? { kind: entry.kind, label: entry.label, href, displayValue: formatChannelDisplay(href) } : null;
  })
  .filter((entry): entry is DirectChannel => entry !== null);

const hasContactEmail = Boolean(settings.email && settings.email.trim().length > 0);
const totalContactChannels = (hasContactEmail ? 1 : 0) + directChannels.length;
---

<PublicLayout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  canonicalPath={canonicalPath}
  ogImage="/og-default.png"
  hreflangs={hreflangs}
  alternateSwitcherUrl={alternatePath}
  settings={settings}
  jsonLd={jsonLd}
>
  <!-- 00: Broadside Hero Band -->
  <section id="hero" data-scroll-section="home" class="hero-reveal relative overflow-hidden bg-[var(--bg-primary)]">
    <div
      aria-hidden="true"
      data-hero-code-bg
      class="hero-code-bg pointer-events-none absolute inset-0 select-none overflow-hidden"
    >
      <div class="mx-auto flex h-full max-w-[1376px] justify-end px-5 pt-3 pb-0 sm:px-10 lg:pr-12">
        <div class="hero-code-frame w-full max-w-[56rem] font-mono text-[13.5px] leading-[1.48] sm:text-[15px] lg:text-[16.5px]">
          <div class="mb-2 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--accent)] sm:text-[12px] lg:text-[13px]">
            <span data-hero-code-lang>PYTHON</span>
            <span class="text-[var(--text-muted)]">//</span>
            <span data-hero-code-file class="normal-case tracking-[0.06em] text-[var(--text-secondary)]">rag_pipeline.py</span>
          </div>
          <pre class="m-0 whitespace-pre-wrap break-words font-mono text-[var(--text-primary)]"><code data-hero-code-text></code><span aria-hidden="true" class="hero-code-caret ml-0.5 inline-block h-[1em] w-[0.5em] align-[-0.14em] bg-[var(--accent)]"></span></pre>
        </div>
      </div>
    </div>

    <div class="relative z-10 mx-auto max-w-[1376px] px-5 pt-8 pb-11 sm:px-10 lg:pt-10 lg:pb-14">
      <div class="flex items-start justify-between gap-6">
        <div class="min-h-[8rem] max-w-[58rem] min-w-0 flex-1 sm:min-h-[9.5rem] lg:min-h-[15rem] lg:pb-16">
          {rotatingHeroSlides.length > 1 && (
            <div
              class="mb-4 flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--text-muted)]"
              data-hero-telemetry
            >
              <span class="inline-flex items-center gap-2 text-[var(--accent)]">
                <span aria-hidden="true" class="hero-pulse-dot h-1.5 w-1.5 bg-[var(--accent)]"></span>
                <span>SYS //</span>
              </span>
              <span data-hero-index class="tabular-nums text-[var(--text-secondary)]">
                01 / {String(rotatingHeroSlides.length).padStart(2, '0')}
              </span>
              <span
                class="relative hidden h-[2px] w-24 overflow-hidden bg-[var(--border-ledger)] sm:inline-block"
                aria-hidden="true"
              >
                <span data-hero-progress class="hero-progress-fill block h-full w-full origin-left bg-[var(--accent)]"></span>
              </span>
              <div class="flex flex-wrap items-center gap-1" role="group" aria-label={slideControlsLabel}>
                {rotatingHeroSlides.map((slide, idx) => (
                  <button
                    type="button"
                    data-hero-dot={idx}
                    aria-label={`${slideLabelPrefix} ${idx + 1}: ${slide.plain}`}
                    aria-pressed={idx === 0 ? 'true' : 'false'}
                    class="hero-step-btn inline-flex h-5 cursor-pointer items-center justify-center rounded-sm border border-[var(--border-ledger)] px-1.5 font-mono text-[10px] tabular-nums text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--text-primary)]"
                  >
                    {String(idx + 1).padStart(2, '0')}
                  </button>
                ))}
              </div>
            </div>
          )}

          <h1
            class="font-display text-[clamp(1.75rem,4.5vw,3.75rem)] font-bold leading-[1.08] tracking-[-0.026em] text-[var(--text-primary)]"
          >
            <span class="block" aria-label={heroLeadSlide.plain}>
              {heroLeadSlide.segments.map((seg) =>
                seg.accent ? (
                  <span class="text-[var(--accent)]">{seg.text}</span>
                ) : (
                  <span>{seg.text}</span>
                ),
              )}
            </span>

            {initialRotatingSlide && (
              <span
                id="hero-rotating-heading"
                data-hero-slides={JSON.stringify(rotatingHeroSlides)}
                aria-label={initialRotatingSlide.plain}
                class="mt-2.5 block font-display text-[clamp(1.35rem,3.4vw,2.85rem)] font-bold leading-[1.12] tracking-[-0.024em] text-[var(--text-primary)]"
              >
                <span data-hero-text>
                  {initialRotatingSlide.segments.map((seg) =>
                    seg.accent ? (
                      <span class="text-[var(--accent)]">{seg.text}</span>
                    ) : (
                      <span>{seg.text}</span>
                    ),
                  )}
                </span>{rotatingHeroSlides.length > 1 && (
                  <span aria-hidden="true" class="hero-cursor ml-1 inline-block h-[0.76em] w-[0.11em] align-[-0.06em] bg-[var(--accent)]"></span>
                )}
              </span>
            )}
          </h1>
        </div>

        <div
          aria-hidden="true"
          class="hidden shrink-0 select-none pt-0.5 pr-1 font-mono text-[12px] font-medium uppercase leading-[1.35] tracking-[0.2em] text-[var(--text-secondary)]/85 lg:block [writing-mode:vertical-rl]"
        >
          <span class="block">PORTFOLIO</span>
          <span class="block">2014–2026</span>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-4 lg:absolute lg:right-10 lg:bottom-12 lg:mt-0 lg:justify-end">
        <a
          href={projectsHref}
          class="inline-flex h-[50px] items-center justify-center rounded-md bg-[var(--accent-fill)] px-6 py-2.5 text-[15.5px] font-semibold text-[var(--accent-ink)] transition-all hover:brightness-95"
        >
          {t.hero.primaryCta}
        </a>
        <a
          href={contactHref}
          class="inline-flex h-[50px] items-center justify-center rounded-md border border-[var(--text-primary)]/25 px-6 py-2.5 text-[15.5px] font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          {t.hero.contactCta}
        </a>
      </div>
    </div>
  </section>

  <!-- 01: Machined Graphite Engineering Ledger Band -->
  <section
    id={aboutSectionId}
    data-scroll-section="about"
    class="scroll-mt-[58px] border-y border-[var(--border-ledger)] bg-[var(--bg-secondary)]"
  >
    <div class="mx-auto max-w-[1376px] px-5 py-10 sm:px-10 lg:py-11">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-0">
        <div class="lg:col-span-4 lg:border-r lg:border-[var(--border-ledger)] lg:pr-6">
          <h2 class="font-display text-lg font-bold uppercase tracking-[-0.02em] text-[var(--text-primary)] xl:whitespace-nowrap xl:text-[1.32rem] xl:leading-[1.2]">
            <span class="monograph-num mr-2 text-[var(--accent)]">01</span>
            {t.about.backgroundTitle}
          </h2>
          <p class="mt-4 max-w-[33ch] text-[15.5px] leading-[1.68] text-[var(--text-secondary)]">
            {backgroundBody}
          </p>
        </div>

        <div class="lg:col-span-4 lg:border-r lg:border-[var(--border-ledger)] lg:px-6">
          <h2 class="font-display text-lg font-bold uppercase tracking-[-0.02em] text-[var(--text-primary)] xl:whitespace-nowrap xl:text-[1.32rem] xl:leading-[1.2]">
            <span class="monograph-num mr-2 text-[var(--accent)]">02</span>
            {t.about.philosophyTitle}
          </h2>
          <p class="mt-4 max-w-[33ch] text-[15.5px] leading-[1.68] text-[var(--text-secondary)]">
            {philosophyBody}
          </p>
        </div>

        <div class="lg:col-span-4 lg:pl-6">
          <h2 class="font-display text-lg font-bold uppercase tracking-[-0.02em] text-[var(--text-primary)] xl:whitespace-nowrap xl:text-[1.32rem] xl:leading-[1.2]">
            <span class="monograph-num mr-2 text-[var(--accent)]">03</span>
            {t.home.stackTitle}
          </h2>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {coreStack.map((item) => (
              <li class="inline-flex items-center gap-1.5 rounded border border-[var(--border-ledger)] bg-[var(--bg-elevated)]/70 px-2 py-[2px] font-mono text-[13px] leading-[1.25] text-[var(--text-primary)]">
                <span aria-hidden="true" class="h-1 w-1 shrink-0 rounded-full bg-[var(--accent)]"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02: Portfolio Showcase Band -->
  <section
    id={projectsSectionId}
    data-scroll-section="projects"
    class="scroll-mt-[58px] border-b border-[var(--border-ledger)] bg-[var(--bg-specimen)] text-[var(--text-specimen)]"
  >
    <div class="mx-auto max-w-[1376px] px-5 pt-9 pb-12 sm:px-10 lg:pt-11 lg:pb-14">
      <div class="flex flex-col justify-between gap-4 border-b border-[var(--border-specimen)] pb-5 md:flex-row md:items-end">
        <div>
          <h2 class="font-display text-2xl font-bold uppercase tracking-[-0.02em] sm:text-[1.9rem] sm:leading-[1.1]">
            <span class="monograph-num mr-2.5 text-[var(--accent)]">04</span>
            {t.projects.title}
          </h2>
          <p class="mt-2.5 text-sm text-[var(--text-specimen-secondary)]">
            {t.projects.subtitle}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 md:justify-end">
          {hasFreelance && (
            <div
              class="portfolio-tab-container inline-flex w-full sm:w-auto items-center rounded border p-1"
              role="tablist"
              aria-label={t.freelance.tabGroupLabel}
            >
              <button
                id="portfolio-tab-main"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="portfolio-panel-main"
                data-portfolio-tab="main"
                class="portfolio-tab-btn inline-flex flex-1 sm:flex-initial min-h-[44px] sm:min-h-[34px] cursor-pointer items-center justify-center gap-2 rounded-[3px] px-3.5 py-1.5 font-mono text-[12.5px] leading-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                <span>{t.freelance.mainTabLabel}</span>
                <span class="rounded border border-current/25 px-1.5 py-0.5 text-[11px] leading-none opacity-85">
                  {allProjects.length}
                </span>
              </button>
              <button
                id="portfolio-tab-freelance"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="portfolio-panel-freelance"
                data-portfolio-tab="freelance"
                class="portfolio-tab-btn inline-flex flex-1 sm:flex-initial min-h-[44px] sm:min-h-[34px] cursor-pointer items-center justify-center gap-2 rounded-[3px] px-3.5 py-1.5 font-mono text-[12.5px] leading-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                <span>{t.freelance.freelanceTabLabel}</span>
                <span class="rounded border border-current/25 px-1.5 py-0.5 text-[11px] leading-none opacity-85">
                  {freelanceItems.length}
                </span>
              </button>
            </div>
          )}
        </div>
      </div>

      <div
        id="portfolio-panel-main"
        data-portfolio-panel="main"
        role={hasFreelance ? 'tabpanel' : undefined}
        aria-labelledby={hasFreelance ? 'portfolio-tab-main' : undefined}
      >
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label={filterGroupLabel}>
            <button
              type="button"
              data-filter-tag="all"
              aria-pressed="true"
              class={pillClass}
            >
              {t.projects.allFilter}
            </button>
            {displayProjectTags.map((tag) => (
              <button
                type="button"
                data-filter-tag={tag.toLowerCase()}
                aria-pressed="false"
                class={pillClass}
              >
                {tag}
              </button>
            ))}
          </div>

          {allProjects.length > 0 && (
            <div
              class="inline-flex items-center rounded border border-[var(--border-ledger)] bg-[var(--bg-elevated)] p-0.5"
              role="group"
              aria-label={viewGroupLabel}
            >
              <button
                type="button"
                data-project-view-btn="grid"
                aria-pressed="true"
                aria-label={gridViewLabel}
                title={gridViewLabel}
                class="project-view-btn inline-flex min-h-[40px] sm:min-h-[28px] cursor-pointer items-center gap-1.5 rounded-[3px] px-2.5 py-1 font-mono text-[12px] leading-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-current">
                  <rect x="2" y="2" width="5" height="5" rx="0.8" />
                  <rect x="9" y="2" width="5" height="5" rx="0.8" />
                  <rect x="2" y="9" width="5" height="5" rx="0.8" />
                  <rect x="9" y="9" width="5" height="5" rx="0.8" />
                </svg>
                <span>Grid</span>
              </button>
              <button
                type="button"
                data-project-view-btn="list"
                aria-pressed="false"
                aria-label={listViewLabel}
                title={listViewLabel}
                class="project-view-btn inline-flex min-h-[40px] sm:min-h-[28px] cursor-pointer items-center gap-1.5 rounded-[3px] px-2.5 py-1 font-mono text-[12px] leading-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
              >
                <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-current">
                  <rect x="2" y="2.5" width="12" height="2.4" rx="0.8" />
                  <rect x="2" y="6.8" width="12" height="2.4" rx="0.8" />
                  <rect x="2" y="11.1" width="12" height="2.4" rx="0.8" />
                </svg>
                <span>List</span>
              </button>
            </div>
          )}
        </div>

        {allProjects.length > 0 ? (
          <>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
              <p
                id="projects-count-status"
                data-prefix={t.projects.countPrefix}
                data-connector={t.projects.countConnector}
                data-unit={t.projects.countUnit}
                data-total={String(allProjects.length)}
                class="monograph-num font-mono text-xs text-[var(--text-specimen-secondary)]"
              >
                {`${t.projects.countPrefix} ${Math.min(6, allProjects.length)} ${t.projects.countConnector} ${allProjects.length} ${t.projects.countUnit}`}
              </p>
            </div>

            <div id="projects-grid" data-view="grid" class="mt-4 grid w-full min-w-0 grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {allProjects.map((project, idx) => (
                <ProjectCard
                  locale={locale}
                  title={project.data.title}
                  slug={project.data.slug}
                  role={project.data.role}
                  summary={project.data.summary}
                  category={project.data.category}
                  tags={project.data.tags}
                  featured={project.data.featured}
                  isConfidential={project.data.isConfidential}
                  coverImage={project.data.coverImage}
                  coverAlt={project.data.coverAlt}
