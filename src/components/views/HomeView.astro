      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      if (portfolioTabs.length < 2) return;
      event.preventDefault();
      const nextIdx =
        event.key === 'ArrowRight'
          ? (idx + 1) % portfolioTabs.length
          : (idx - 1 + portfolioTabs.length) % portfolioTabs.length;
      const targetBtn = portfolioTabs[nextIdx];
