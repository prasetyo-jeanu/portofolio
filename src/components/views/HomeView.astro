  function updateProjectStatusAndExpand(visibleCount: number) {
    if (projectsCountStatus) {
      const prefix = projectsCountStatus.getAttribute('data-prefix') || 'Showing';
      const connector = projectsCountStatus.getAttribute('data-connector') || 'of';
      const unit = projectsCountStatus.getAttribute('data-unit') || 'projects';
      const total = projectsCountStatus.getAttribute('data-total') || String(projectCards.length);
      projectsCountStatus.textContent = `${prefix} ${visibleCount} ${connector} ${total} ${unit}`;
    }

    if (projectsExpandWrap) {
      projectsExpandWrap.classList.toggle('hidden', selectedProjectTag !== 'all');
    }

    if (projectsExpandBtn) {
      projectsExpandBtn.setAttribute('data-expanded', String(projectsExpanded));
      const labelEl = projectsExpandBtn.querySelector('[data-expand-label]');
      const iconEl = projectsExpandBtn.querySelector('[data-expand-icon]');
      const nextLabel = projectsExpanded
        ? projectsExpandBtn.getAttribute('data-show-less-label') || 'Show less'
        : projectsExpandBtn.getAttribute('data-show-all-label') || 'Show all';
      if (labelEl) labelEl.textContent = nextLabel;
      if (iconEl) iconEl.classList.toggle('rotate-180', projectsExpanded);
    }
  }

  function applyProjectFilters() {
    let visibleCount = 0;
    projectCards.forEach((card) => {
      const rawTags = card.getAttribute('data-tags') || '';
      const tags = rawTags.split(',').filter(Boolean);
      const isOverflow = card.getAttribute('data-project-overflow') === 'true';
      const matchesTag = selectedProjectTag === 'all' || tags.includes(selectedProjectTag);
      const shouldShow =
        selectedProjectTag === 'all' ? !isOverflow || projectsExpanded : matchesTag;
      card.classList.toggle('hidden', !shouldShow);
      if (shouldShow) visibleCount += 1;
    });

    if (emptyFilterNotice) {
      emptyFilterNotice.classList.toggle('hidden', visibleCount > 0);
    }
    if (emptyStateNotice) {
      emptyStateNotice.textContent =
        selectedProjectTag === 'all'
          ? emptyStateNotice.dataset.emptyAll || ''
          : emptyStateNotice.dataset.emptyFilter || '';
    }
    updateProjectStatusAndExpand(visibleCount);
  }

