---
interface Props {
  type?: 'info' | 'tip' | 'warning' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;
const safeType = ['info', 'tip', 'warning', 'danger'].includes(type) ? type : 'info';
---

<aside class={`mdx-callout mdx-callout-${safeType}`} data-callout={safeType}>
  {title && (
    <p class="font-semibold text-[var(--text-primary)] mb-1">{title}</p>
  )}
  <div class="text-sm leading-relaxed [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</aside>
