---
interface Props {
  title: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
  alertId?: string;
}

const { title, subtitle, backHref, backLabel, alertId } = Astro.props;
---

<header class="sticky top-0 z-30 -mx-4 -mt-4 mb-6 border-b border-[var(--border-subtle)] bg-[var(--bg-primary)]/95 px-4 py-3.5 backdrop-blur-md sm:-mx-8 sm:-mt-8 sm:px-8 sm:py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      {backHref && backLabel && (
        <a href={backHref} class="text-xs text-[var(--accent)] hover:underline">
          &larr; {backLabel}
        </a>
      )}
      <h1 class="mt-0.5 truncate text-xl font-bold text-[var(--text-primary)] sm:text-2xl">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-0.5 text-xs text-[var(--text-muted)] sm:text-sm">
          {subtitle}
        </p>
      )}
    </div>

    <div class="flex shrink-0 flex-wrap items-center gap-2.5">
      <slot name="actions" />
    </div>
  </div>

  {alertId && <div id={alertId} class="hidden mt-3 rounded-xl px-4 py-2.5 text-sm"></div>}
</header>
