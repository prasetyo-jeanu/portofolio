{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bilingual Portfolio Project File",
  "description": "Structured canonical project schema for src/seed/projects/<slug>/project.json imported into SQLite via bun run portfolio:import.",
  "type": "object",
  "required": [
    "id",
    "project_name",
    "category",
    "featured",
    "sort_order",
    "status",
    "tech_stack_tags",
    "image",
    "translations"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "project_name": { "type": "string" },
    "category": { "type": "string" },
    "featured": { "type": "boolean" },
    "sort_order": { "type": "integer", "minimum": 0 },
    "is_confidential": { "type": "boolean", "default": false },
    "status": { "type": "string", "enum": ["draft", "published", "archived"] },
    "demo_url": { "type": ["string", "null"] },
    "repo_url": { "type": ["string", "null"] },
    "tech_stack_tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "image": {
      "type": "object",
      "required": ["file", "width", "height", "aspect_ratio", "alt"],
      "properties": {
        "file": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "aspect_ratio": { "type": "string", "const": "1:1" },
        "alt": {
          "type": "object",
          "required": ["en", "id"],
          "properties": {
            "en": { "type": "string" },
            "id": { "type": "string" }
          }
        }
      }
    },
    "translations": {
      "type": "object",
      "required": ["en", "id"],
      "properties": {
        "en": { "$ref": "#/$defs/localeEntry" },
        "id": { "$ref": "#/$defs/localeEntry" }
      }
    }
  },
  "$defs": {
    "localeEntry": {
      "type": "object",
      "required": ["title", "slug", "role", "summary", "portfolio_copy"],
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "role": { "type": "string" },
        "summary": { "type": "string" },
        "portfolio_copy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "properties": {
              "label": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
